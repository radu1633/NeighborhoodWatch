{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.js",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "app/index.jsx",
    "app/_layout.jsx",
    "app/(tabs)/profile.jsx",
    "app/(tabs)/home.jsx",
    "app/(tabs)/create.jsx",
    "app/(tabs)/contacts.jsx",
    "app/(tabs)/_layout.jsx",
    "app/(tabs)/analytics.jsx"
  ]
}
